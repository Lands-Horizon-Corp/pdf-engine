{
  "name": "@lands-horizon-corp/pdf-engine-wasm",
  "version": "1.1.1",
  "description": "HTML to PDF in the browser (React, Vue, Svelte and more): the pdf-engine renderer compiled to WebAssembly. No server.",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "jsdelivr": "index.js",
  "unpkg": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./wasm": "./dist/pdf_engine_wasm_bg.wasm",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.d.ts",
    "routing.js",
    "dist/pdf_engine_wasm.js",
    "dist/pdf_engine_wasm_bg.wasm",
    "fonts",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lands-Horizon-Corp/pdf-engine.git",
    "directory": ".node/wasm"
  },
  "keywords": [
    "pdf",
    "html-to-pdf",
    "wasm",
    "webassembly",
    "invoice",
    "receipt",
    "react",
    "vue",
    "svelte"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
