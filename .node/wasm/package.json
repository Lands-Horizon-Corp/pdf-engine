{
  "name": "@lands-horizon-corp/pdf-engine-wasm",
  "version": "1.5.0",
  "description": "HTML to PDF for the browser and Node.js: a Rust layout engine compiled to WebAssembly. Real vector text, Markdown, LaTeX math, QR codes. No server, no Chromium, no Puppeteer. Works in React, Vue, Svelte and Next.js.",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "jsdelivr": "index.js",
  "unpkg": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./wasm": "./dist/pdf_engine_wasm_bg.wasm",
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json",
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.js",
      "default": "./react.js"
    },
    "./vue": {
      "types": "./vue.d.ts",
      "import": "./vue.js",
      "default": "./vue.js"
    },
    "./svelte": {
      "types": "./svelte.d.ts",
      "import": "./svelte.js",
      "default": "./svelte.js"
    }
  },
  "sideEffects": false,
  "files": [
    "index.js",
    "index.d.ts",
    "svelte.d.ts",
    "svelte.js",
    "vue.d.ts",
    "vue.js",
    "react.d.ts",
    "react.js",
    "routing.js",
    "worker.js",
    "pool.js",
    "worker-core.js",
    "from-element.js",
    "worker-node.js",
    "dist/pdf_engine_wasm.js",
    "dist/pdf_engine_wasm_bg.wasm",
    "fonts",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lands-Horizon-Corp/pdf-engine.git",
    "directory": ".node/wasm"
  },
  "keywords": [
    "pdf",
    "html-to-pdf",
    "html2pdf",
    "pdf-generator",
    "pdf-generation",
    "generate-pdf",
    "create-pdf",
    "nodejs",
    "node",
    "browser",
    "client-side",
    "wasm",
    "webassembly",
    "rust",
    "typescript",
    "javascript",
    "invoice",
    "receipt",
    "thermal-printer",
    "escpos",
    "zpl",
    "qr-code",
    "barcode",
    "markdown-to-pdf",
    "latex",
    "math",
    "puppeteer-alternative",
    "html2pdf-alternative",
    "jspdf-alternative",
    "headless-chrome-alternative",
    "no-chromium",
    "serverless",
    "offline",
    "react",
    "vue",
    "svelte",
    "nextjs",
    "electron",
    "tauri",
    "template",
    "report"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17",
    "vue": "^3.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "homepage": "https://lands-horizon-corp.github.io/pdf-engine/",
  "bugs": {
    "url": "https://github.com/Lands-Horizon-Corp/pdf-engine/issues"
  },
  "author": "Lands Horizon <https://github.com/Lands-Horizon-Corp>"
}
