{
  "name": "pdf-engine-bench",
  "private": true,
  "type": "module",
  "description": "Compares pdf-engine with the other HTML-to-PDF packages: Puppeteer, html2pdf.js, jspdf-html2canvas, html-pdf and wkhtmltopdf. Run: npm install && npm run setup:tools && npm run bench",
  "scripts": {
    "build": "vite build --config browser/vite.config.js",
    "check": "node check.mjs",
    "bench:browser": "node browser.mjs",
    "bench:node": "node node.mjs",
    "scale": "node scale.mjs",
    "stats": "node npm-stats.mjs",
    "charts": "node charts.mjs",
    "bench": "npm run build && npm run bench:browser && npm run bench:node && npm run charts",
    "setup:tools": "node setup-tools.mjs"
  },
  "dependencies": {
    "@lands-horizon-corp/pdf-engine": "file:../../.node/desktop",
    "@lands-horizon-corp/pdf-engine-wasm": "file:../../.node/wasm",
    "dompdf.js": "^2.0.7",
    "html-pdf": "^3.0.1",
    "html2pdf.js": "^0.14.0",
    "ironpress": "^1.7.0",
    "jspdf-html2canvas": "^1.7.0",
    "pdfjs-dist": "^5.0.0",
    "phantomjs-prebuilt": "^2.1.16",
    "playwright": "^1.64.1",
    "puppeteer": "^25.16.0",
    "vite": "^8.3.4"
  }
}
