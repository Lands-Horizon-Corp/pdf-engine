{
  "invoice": {
    "label": "Invoice (loop, table, logo)",
    "options": {},
    "template": "<style>\n  body { font-family: sans-serif; color: #1f2937; padding: 36px; font-size: 13px; }\n  .top { display: flex; justify-content: space-between; align-items: center; }\n  h1 { margin: 0; font-size: 26px; color: #2563eb; }\n  table { width: 100%; border-collapse: collapse; margin-top: 24px; }\n  th { text-align: left; background: #eff4ff; padding: 8px; }\n  td { padding: 8px; border-bottom: 1px solid #e5e7eb; }\n  .r { text-align: right; }\n  .total { margin-top: 16px; text-align: right; font-size: 18px; font-weight: bold; }\n</style>\n\n<div class=\"top\">\n  <div>\n    <h1>Invoice {{ no }}</h1>\n    <div>{{ customer }}</div>\n  </div>\n  <img src=\"logo\" width=\"72\">\n</div>\n\n<table>\n  <tr><th>Item</th><th class=\"r\">Qty</th><th class=\"r\">Price</th><th class=\"r\">Amount</th></tr>\n  {% for item in items %}\n  <tr>\n    <td>{{ item.name }}</td>\n    <td class=\"r\">{{ item.qty }}</td>\n    <td class=\"r\">₱{{ item.price }}</td>\n    <td class=\"r\">₱{{ item.qty * item.price }}</td>\n  </tr>\n  {% endfor %}\n</table>\n\n<div class=\"total\">Total ₱{{ total }}</div>",
    "data": {
      "no": "2026-0042",
      "customer": "Juan dela Cruz, Manila",
      "items": [
        {
          "name": "Website hosting (12 months)",
          "qty": 1,
          "price": 1500
        },
        {
          "name": "Domain name",
          "qty": 1,
          "price": 450
        },
        {
          "name": "Design review",
          "qty": 3,
          "price": 800
        },
        {
          "name": "Priority support",
          "qty": 2,
          "price": 250
        }
      ],
      "total": 4850
    }
  },
  "receipt": {
    "label": "Receipt (80 mm paper)",
    "options": {
      "width": "80mm",
      "height": "170mm"
    },
    "template": "<style>\n  body { font-family: sans-serif; font-size: 12px; padding: 6px 10px; color: #000; }\n  .c { text-align: center; }\n  .row { display: flex; justify-content: space-between; margin: 2px 0; }\n  hr { border: 0; border-top: 1px dashed #000; margin: 8px 0; }\n  .big { font-size: 15px; font-weight: bold; }\n</style>\n<div class=\"c\"><img src=\"logo\" width=\"44\"><div class=\"big\">{{ store }}</div><div>{{ address }}</div></div>\n<hr>\n{% for i in lines %}\n<div class=\"row\"><span>{{ i.qty }} x {{ i.name }}</span><span>₱{{ i.qty * i.price }}</span></div>\n{% endfor %}\n<hr>\n<div class=\"row big\"><span>TOTAL</span><span>₱{{ total }}</span></div>\n<div class=\"row\"><span>Cash</span><span>₱{{ cash }}</span></div>\n<div class=\"row\"><span>Change</span><span>₱{{ cash - total }}</span></div>\n<hr>\n<div class=\"c\">Thank you! Salamat po!</div>\n<div class=\"c\" style=\"margin-top:8px\"><barcode value=\"{{ no }}\" type=\"code128\" width=\"200\" height=\"40\" /></div>",
    "data": {
      "store": "Sari-Sari Corner",
      "address": "12 Rizal St, Quezon City",
      "no": "000417",
      "lines": [
        {
          "name": "Sardines",
